PLAID_ENV=production

# From your Plaid dashboard (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_PRODUCTION_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your Google email — only this address can authenticate
ALLOWED_EMAIL=

# Public HTTPS URL of this server (no trailing slash)
BASE_URL=https://yourdomain.com

# SQLite for self-hosting; swap for postgres:// if you prefer
DATABASE_URL=sqlite:///./plaid_mcp.db
